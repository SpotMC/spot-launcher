# Updates folder is public (static downloads for the launcher's generic feed).
# Disable PHP execution in case any stray .php file is dropped here.
<FilesMatch "\.(php|phar|phtml|pht)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
Options -Indexes
